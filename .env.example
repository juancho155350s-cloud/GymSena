# ==============================================================================
# GymSENA - Variables de Entorno para Producción y Desarrollo
# Copia este archivo como .env y ajusta los valores correspondientes
# ==============================================================================

# Entorno de la aplicación ('production' o 'development')
APP_ENV=production
APP_NAME="GymSENA PWA"
APP_URL=http://localhost:8080

# Conexión a Base de Datos MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gymsena_db
DB_USER=root
DB_PASS=

# Configuración Operativa del Gimnasio
DEFAULT_GYM_ID=1
DEFAULT_CAPACITY=35
SCHEDULE_OPEN=06:00:00
SCHEDULE_CLOSE=20:00:00

# Seguridad de Sesión
SESSION_LIFETIME=28800

